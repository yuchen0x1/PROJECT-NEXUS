{
  "name": "project-nexus",
  "version": "0.2.1",
  "description": "Windows AI development and project operations workstation",
  "author": {
    "name": "PROJECT NEXUS"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "desktop:dev": "npm run build && electron .",
    "desktop:package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:desktop": "npm run build && node tests/desktop.smoke.mjs",
    "test:desktop:agent": "npm run build && node tests/local-agent-desktop-ui.mjs",
    "test:desktop:i18n": "npm run build && node tests/desktop-i18n.mjs",
    "test:desktop:quality": "npm run build && node tests/desktop-quality.mjs",
    "test:desktop:perf": "npm run build && node tests/desktop-perf.mjs",
    "i18n:audit": "node scripts/i18n-deep-audit.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:ui": "node tests/smoke.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cors": "latest",
    "express": "latest",
    "i18next": "^25.10.10",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^16.6.6",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "playwright": "^1.65.0",
    "typescript": "latest",
    "vitest": "latest"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.projectnexus.workstation",
    "productName": "PROJECT NEXUS",
    "asar": true,
    "directories": {
      "buildResources": "desktop/assets",
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/app.ico",
      "artifactName": "PROJECT-NEXUS-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "publish": null,
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PROJECT NEXUS",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@45.3.1": true
  }
}
