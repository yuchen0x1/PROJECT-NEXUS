{
  "name": "project-nexus",
  "version": "0.8.3",
  "description": "Windows AI development and project operations workstation",
  "author": {
    "name": "PROJECT NEXUS"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "desktop:dev": "npm run build && electron .",
    "desktop:package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "desktop:verify-update": "node scripts/verify-desktop-update.mjs",
    "test:desktop": "npm run build && node tests/desktop.smoke.mjs",
    "test:desktop:agent": "npm run build && node tests/local-agent-desktop-ui.mjs",
    "test:desktop:i18n": "npm run build && node tests/desktop-i18n.mjs",
    "test:desktop:quality": "npm run build && node tests/desktop-quality.mjs",
    "test:desktop:perf": "npm run build && node tests/desktop-perf.mjs",
    "i18n:audit": "node scripts/i18n-deep-audit.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:ui": "node tests/smoke.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:desktop:agent-runtime": "npm run build && node tests/agent-runtime-desktop-ui.mjs",
    "test:phase6:acceptance": "node tests/phase6-acceptance.mjs"
  },
  "dependencies": {
    "cors": "latest",
    "electron-updater": "6.8.12",
    "express": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "i18next": "^25.10.10",
    "lucide-react": "latest",
    "playwright": "^1.65.0",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^16.6.6",
    "typescript": "latest",
    "typescript-eslint": "8.72.2",
    "vite": "latest",
    "vitest": "latest"
  },
  "main": "desktop/main.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuchen0x1/PROJECT-NEXUS.git"
  },
  "build": {
    "appId": "com.projectnexus.workstation",
    "productName": "PROJECT NEXUS",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "yuchen0x1",
      "repo": "PROJECT-NEXUS",
      "releaseType": "release"
    },
    "asarUnpack": [
      "server/services/agent/windows-job-runner.ps1"
    ],
    "directories": {
      "buildResources": "desktop/assets",
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/app.ico",
      "artifactName": "PROJECT-NEXUS-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "installerIcon": "desktop/assets/app.ico",
      "uninstallerIcon": "desktop/assets/app.ico",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PROJECT NEXUS",
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "desktop/after-pack.cjs"
  },
  "allowScripts": {
    "electron@45.3.1": true
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.8"
  }
}
