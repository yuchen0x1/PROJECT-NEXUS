# Reproducible dependencies, bundles and installer output.
/node_modules/
/dist/
/release*/

# Local application data; only migration definitions belong in Git.
/data/*
!/data/.gitkeep
!/data/migrations/
/logs/

# Credentials and local environment settings.
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.pem

# Generated reports and caches. Curated historical evidence stays tracked.
/playwright-report/
/test-results/
/coverage/
/.cache/
/.vite/
/NVIDIA Corporation/
*.log
!/docs/evidence/**/*.log
*.bak
*.tmp
*.temp
*.tsbuildinfo
Thumbs.db
Desktop.ini
.DS_Store
